# Minecraft/Purpur version. Set PURPUR_BUILD to a number to pin a build.
MC_VERSION=26.1.2
PURPUR_BUILD=latest

# Use auto to prefer the portable runtime installed in runtime/java.
JAVA_CMD=auto
MIN_MEMORY=2G
MAX_MEMORY=4G

# Runtime file name. Usually this should not be changed.
SERVER_JAR=server.jar

# Required QSMP resource pack. Use your public host/IP here for friends outside LAN.
PYTHON_CMD=uv
RESOURCE_PACK_PUBLIC_URL=http://100.94.221.103:25566/qsmp-frontier-pack.zip
